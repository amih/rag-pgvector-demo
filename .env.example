# Copy to .env: cp .env.example .env
DATABASE_URL=postgres://rag:rag@localhost:5462/rag

# Ollama (https://ollama.com) — run models locally, no API keys.
OLLAMA_URL=http://localhost:11434

# Embedding model. nomic-embed-text = 768 dims. If you change the model,
# update EMBED_DIM to match, then re-run `npm run schema` on a fresh DB.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Chat/generation model for the final answer.
# llama3.1:8b gives noticeably better grounded answers than the tiny llama3.2 (3B),
# which tends to refuse ("I don't know") even when the right passages were retrieved.
# On a big machine, qwen2.5:14b-instruct or larger is better still (slower on CPU).
CHAT_MODEL=llama3.1:8b

# How many chunks to retrieve and stuff into the prompt.
TOP_K=5

# Generation context window. Must be big enough for the passages + the question,
# or Ollama truncates the prompt and the model "loses" the question and refuses.
NUM_CTX=8192

# Lower = more grounded, less creative.
TEMPERATURE=0.2
