# cp .env.example .env ; then:  set -a; . ./.env; set +a

# --- data ---
ZIM_PATH=/mnt/hdd/wikipedia/kiwix/wikipedia_en_all_nopic_2026-06.zim

# --- postgres (the tuned NVMe-backed instance from docker-compose.wiki.yml) ---
DATABASE_URL=postgres://rag:rag@localhost:5463/wiki

# --- vector storage ---
# halfvec (fp16) ~halves disk + index vs vector (fp32), ~no recall loss (pgvector>=0.7).
VECTOR_TYPE=halfvec
# EMBED_DIM is set with the model below (tie them together).

# --- embedding backend ---
# st = sentence-transformers on the GPU. ollama = zero-setup fallback (~32 ch/s).
EMBED_BACKEND=st
# Model menu (MEASURED on the GTX 1080 — see README):
#   nomic-ai/nomic-embed-text-v1.5   dim 768   57/s   ~6.1 days   150 GB   best quality  <-- chosen
#   BAAI/bge-small-en-v1.5           dim 384  152/s   ~2.3 days    90 GB
#   sentence-transformers/all-MiniLM-L6-v2  dim 384  286/s  ~1.2 days  90 GB  fastest, weaker
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_DIM=768
# batch 256 OOMs on 8 GB; 32 is fastest for nomic-768 (padding-bound, not batch-bound).
EMBED_BATCH=32
DEVICE=cuda
# set for the 8 GB card to avoid fragmentation OOM:
# export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- chunking ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

# --- ingest ---
ARTICLE_BATCH=400
# MAX_ARTICLES=50000     # uncomment for a subset run first, then remove to continue

# --- query / generation ---
TOP_K=6
EF_SEARCH=100
CHAT_MODEL=qwen2.5:14b

# --- index build (Threadripper: crank these) ---
MAINTENANCE_WORK_MEM=16GB
PARALLEL_WORKERS=8
INDEX_TYPE=hnsw          # or ivfflat for a much faster first-pass build
